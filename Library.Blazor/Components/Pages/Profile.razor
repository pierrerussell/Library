@page "/profile"
@using Library.Application.Members
@using Library.Domain.Books
@using Library.Domain.Members
@using Library.Domain.Reservations
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize]
@inject IMemberRepository MemberRepository
@inject AuthenticationStateProvider AuthenticationStateProvider
@rendermode InteractiveServer 
@inject NavigationManager Navigation
@inject IMediator Mediator
@inject IBookRepository BookRepository
<MudText Typo="Typo.h4" Class="mb-4">My Profile</MudText>

@if (memberDashboardDto is not null && member is not null)
{
    <MudPaper class="mt-4 mb-4 pa-4" Elevation="2">
        <MudText Typo="Typo.h6">Name: @memberDashboardDto.Member.Name</MudText>
        <MudText Typo="Typo.body2">Email: @memberDashboardDto.Member.Email</MudText>
        <MudText Typo="Typo.subtitle1" Class="mt-4">Interests</MudText>
        <MudTextField @bind-Value="newInterest" Label="Add interest" Immediate="true"
                      OnKeyDown="@(async e => { if (e.Key == "Enter") await AddInterest(); })" />
        <MudButton Variant="Variant.Filled" Class="mt-2" OnClick="@AddInterest">Add</MudButton>
    </MudPaper>
    
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
        <MudTabPanel Text="Active Loans">
            <MudTable Items="@memberDashboardDto.ActiveLoans" Hover="true">
                <HeaderContent>
                    <MudTh>Title</MudTh><MudTh>Due</MudTh><MudTh>Status</MudTh><MudTh>Fee</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@books[context.BookId].Title</MudTd>
                    <MudTd>@context.DueDate.DateTime.ToShortDateString()</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd>@context.CalculateLateFee(DateTimeOffset.UtcNow)</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="History">
            <MudTable Items="@memberDashboardDto.PastLoans" Hover="true">
                <HeaderContent>
                    <MudTh>Title</MudTh><MudTh>Checked Out</MudTh><MudTh>Returned</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@books[context.BookId].Title</MudTd>
                    <MudTd>@context.CheckoutDate.DateTime.ToShortDateString()</MudTd>
                    <MudTd>@context.ReturnDate?.DateTime.ToShortDateString()</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Reservations">
            <MudTable Items="@memberDashboardDto.Reservations" Hover="true">
                <HeaderContent>
                    <MudTh>Title</MudTh><MudTh>Reserved</MudTh><MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@books[context.BookId].Title</MudTd>
                    <MudTd>@context.ReservationDate.DateTime.ToShortDateString()</MudTd>
                    <MudTd>
                        <MudChip T="string" Color="@(context.Status == ReservationStatus.Notified ? Color.Success : Color.Default)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Payments">
            <MudTable Items="@memberDashboardDto.Payments" Hover="true">
                <HeaderContent>
                    <MudTh>Date</MudTh><MudTh>Reason</MudTh><MudTh>Amount</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.DateTime.ToShortDateString()</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@context.Amount</MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="Interests">
            @foreach (var interest in memberDashboardDto.Member.Interests)
            {
                <MudChip T="string">@interest</MudChip>
            }
        </MudTabPanel>
    </MudTabs>
    
}

@code {
    private Member? member;
    private string newInterest = "";
    private MemberDashboardDto? memberDashboardDto;
    private Dictionary<Guid, Book> books = new();
    

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity is not { IsAuthenticated: true })
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
        var identityUserId = Guid.Parse(authState.User.FindFirst(c => c.Type == "sub"
        || c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
        member = await MemberRepository.GetByIdentityUserIdAsync(identityUserId);
        
        memberDashboardDto = await Mediator.Send(new GetMemberDashboardQuery(member!.Id));
        books = (await BookRepository.GetAllAsync()).ToDictionary(b => b.Id);
    }
    private async Task AddInterest()
    {
        if (string.IsNullOrWhiteSpace(newInterest) || member is null) return;
        Console.WriteLine(newInterest);
        member.AddInterest(newInterest);
        await MemberRepository.SaveChangesAsync();
        newInterest = "";
    }
    
    private async Task RemoveInterest(string interest)
    {
        if (member is null) return;
        member.RemoveInterest(interest);
        await MemberRepository.SaveChangesAsync();
    }
}